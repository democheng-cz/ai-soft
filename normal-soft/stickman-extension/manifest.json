{
  "manifest_version": 3,
  "name": "Stickman Platform Game",
  "version": "1.0",
  "description": "Play as a stickman walking on webpage elements. Arrow keys to move, collect items for power-ups!",
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stickman Game"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-game": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle Stickman Game"
    }
  }
}
